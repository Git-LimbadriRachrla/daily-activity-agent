# ============================================================================
# Gemini & Google Antigravity Agent Configuration
# Get an API key at: https://aistudio.google.com/app/api-keys
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Google Calendar API Integration
# Supports either:
# 1. OAuth2 Access Token (GOOGLE_CALENDAR_ACCESS_TOKEN)
# 2. Service Account JSON file path (GOOGLE_APPLICATION_CREDENTIALS)
# ============================================================================
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
TIMEZONE=Asia/Kolkata

# ============================================================================
# External Timesheet Webhook / API Integration
# Receives JSON payloads when daily timesheets are submitted
# ============================================================================
TIMESHEET_WEBHOOK_URL=https://httpbin.org/post
TIMESHEET_API_KEY=
TIMESHEET_EMPLOYEE_ID=EMP-2026-01

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8000
HOST=127.0.0.1
